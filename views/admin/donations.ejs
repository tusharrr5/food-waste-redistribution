<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Donations — FoodShare Admin</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #1a1a2e; color: #e5e7eb; }

        .navbar {
            background: #16213e; padding: 0 32px; height: 60px;
            display: flex; align-items: center; justify-content: space-between;
            border-bottom: 1px solid #0f3460;
        }
        .navbar .logo { color: #e5e7eb; font-size: 20px; font-weight: bold; text-decoration: none; }
        .navbar .logo span { color: #f59e0b; }
        .navbar-right a {
            color: #9ca3af; text-decoration: none; font-size: 14px;
            border: 1px solid #4b5563; padding: 5px 14px; border-radius: 4px;
        }
        .navbar-right a:hover { background: #0f3460; color: #e5e7eb; }

        .layout { display: flex; min-height: calc(100vh - 60px); }
        .sidebar {
            width: 200px; background: #16213e;
            padding: 24px 0; border-right: 1px solid #0f3460; flex-shrink: 0;
        }
        .sidebar a {
            display: block; padding: 12px 24px; color: #9ca3af;
            text-decoration: none; font-size: 14px; font-weight: 500; transition: all 0.2s;
        }
        .sidebar a:hover, .sidebar a.active { background: #0f3460; color: #f59e0b; }

        .content { flex: 1; padding: 36px 32px; }

        .page-title { font-size: 22px; font-weight: bold; color: #f59e0b; margin-bottom: 20px; }

        /* Filter Tabs */
        .filter-bar { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
        .filter-link {
            padding: 6px 16px; border-radius: 20px; font-size: 13px;
            font-weight: 600; text-decoration: none; transition: all 0.2s;
            background: #16213e; color: #9ca3af; border: 1px solid #0f3460;
        }
        .filter-link:hover { border-color: #f59e0b; color: #f59e0b; }
        .filter-link.active { background: #f59e0b; color: #1a1a1a; border-color: #f59e0b; }

        /* Table */
        .table-wrap {
            background: #16213e; border-radius: 10px;
            border: 1px solid #0f3460; overflow: hidden;
        }
        table { width: 100%; border-collapse: collapse; }
        thead { background: #0f3460; }
        th { padding: 12px 14px; text-align: left; font-size: 12px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; }
        td { padding: 13px 14px; font-size: 13px; border-bottom: 1px solid #0f3460; color: #d1d5db; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #0f3460; }

        .badge {
            display: inline-block; padding: 3px 10px; border-radius: 12px;
            font-size: 11px; font-weight: 600; text-transform: capitalize;
        }
        .badge-available  { background: #064e3b; color: #6ee7b7; }
        .badge-accepted   { background: #1e3a8a; color: #93c5fd; }
        .badge-pickedup   { background: #78350f; color: #fcd34d; }
        .badge-delivered  { background: #14532d; color: #86efac; }
        .badge-cancelled  { background: #7f1d1d; color: #fca5a5; }

        .btn {
            display: inline-block; padding: 5px 14px; border-radius: 4px;
            font-size: 12px; font-weight: bold; text-decoration: none;
            cursor: pointer; border: none; transition: opacity 0.15s;
        }
        .btn:hover { opacity: 0.85; }
        .btn-red { background: #dc2626; color: #fff; }

        .empty-state {
            text-align: center; padding: 60px 20px; color: #4b5563;
        }
        @media (max-width: 768px) { .sidebar { display: none; } }
    </style>
</head>
<body>

    <header class="navbar">
        <a href="/admin/dashboard" class="logo">Food<span>Share</span> <small style="font-size:12px;color:#6b7280;">Admin</small></a>
        <div class="navbar-right">
            <a href="/logout">Logout</a>
        </div>
    </header>

    <div class="layout">
        <nav class="sidebar">
            <a href="/admin/dashboard">📊 Dashboard</a>
            <a href="/admin/donations" class="active">🍱 All Donations</a>
            <a href="/admin/users">👥 All Users</a>
        </nav>

        <div class="content">
            <div class="page-title">🍱 All Donations</div>

            <!-- Filter Tabs -->
            <div class="filter-bar">
                <a href="/admin/donations?status=all"       class="filter-link <%= filter === 'all'       ? 'active' : '' %>">All</a>
                <a href="/admin/donations?status=available" class="filter-link <%= filter === 'available' ? 'active' : '' %>">Available</a>
                <a href="/admin/donations?status=accepted"  class="filter-link <%= filter === 'accepted'  ? 'active' : '' %>">Accepted</a>
                <a href="/admin/donations?status=pickedUp"  class="filter-link <%= filter === 'pickedUp'  ? 'active' : '' %>">Picked Up</a>
                <a href="/admin/donations?status=delivered" class="filter-link <%= filter === 'delivered' ? 'active' : '' %>">Delivered</a>
                <a href="/admin/donations?status=cancelled" class="filter-link <%= filter === 'cancelled' ? 'active' : '' %>">Cancelled</a>
            </div>

            <div class="table-wrap">
                <% if (donations.length === 0) { %>
                    <div class="empty-state">No donations found.</div>
                <% } else { %>
                    <!-- Reference: Lect-13/views/index.ejs table + forEach pattern -->
                    <table>
                        <thead>
                            <tr>
                                <th>Food Type</th>
                                <th>Qty</th>
                                <th>Location</th>
                                <th>Donor</th>
                                <th>NGO</th>
                                <th>Expires</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% donations.forEach((d) => { %>
                                <%
                                    let badgeClass = 'badge-available';
                                    if (d.status === 'accepted')  badgeClass = 'badge-accepted';
                                    if (d.status === 'pickedUp')  badgeClass = 'badge-pickedup';
                                    if (d.status === 'delivered') badgeClass = 'badge-delivered';
                                    if (d.status === 'cancelled') badgeClass = 'badge-cancelled';
                                %>
                                <tr>
                                    <td><strong><%= d.foodType %></strong></td>
                                    <td><%= d.quantity %></td>
                                    <td><%= d.pickupLocation %></td>
                                    <td><%= d.donorName || '—' %></td>
                                    <td><%= d.ngoName || '—' %></td>
                                    <td><%= d.expiresAt ? new Date(d.expiresAt).toLocaleDateString('en-IN') : '—' %></td>
                                    <td><span class="badge <%= badgeClass %>"><%= d.status %></span></td>
                                    <td>
                                        <% if (d.status !== 'cancelled' && d.status !== 'delivered') { %>
                                            <form action="/admin/donation/<%= d._id %>/cancel" method="POST" style="display:inline;">
                                                <button type="submit" class="btn btn-red"
                                                    onclick="return confirm('Cancel this donation?')">
                                                    Cancel
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span style="color:#4b5563;font-size:12px;">—</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </div>

</body>
</html>
