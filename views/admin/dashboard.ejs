<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard — FoodShare</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #1a1a2e; color: #e5e7eb; }

        .navbar {
            background: #16213e; padding: 0 32px; height: 60px;
            display: flex; align-items: center; justify-content: space-between;
            border-bottom: 1px solid #0f3460;
        }
        .navbar .logo { color: #e5e7eb; font-size: 20px; font-weight: bold; text-decoration: none; }
        .navbar .logo span { color: #f59e0b; }
        .navbar-right { display: flex; align-items: center; gap: 20px; }
        .navbar-right span { color: #9ca3af; font-size: 14px; }
        .navbar-right a {
            color: #9ca3af; text-decoration: none; font-size: 14px;
            border: 1px solid #4b5563; padding: 5px 14px; border-radius: 4px;
        }
        .navbar-right a:hover { background: #0f3460; color: #e5e7eb; }

        /* Sidebar nav */
        .layout { display: flex; min-height: calc(100vh - 60px); }
        .sidebar {
            width: 200px; background: #16213e;
            padding: 24px 0; border-right: 1px solid #0f3460;
            flex-shrink: 0;
        }
        .sidebar a {
            display: block; padding: 12px 24px; color: #9ca3af;
            text-decoration: none; font-size: 14px; font-weight: 500;
            transition: all 0.2s;
        }
        .sidebar a:hover, .sidebar a.active { background: #0f3460; color: #f59e0b; }

        .content { flex: 1; padding: 36px 32px; }

        .page-title { font-size: 26px; font-weight: bold; color: #f59e0b; margin-bottom: 6px; }
        .page-sub { color: #6b7280; font-size: 14px; margin-bottom: 28px; }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 14px;
            margin-bottom: 32px;
        }
        .stat-card {
            background: #16213e; border-radius: 10px; padding: 20px 16px;
            text-align: center; border: 1px solid #0f3460;
        }
        .stat-card .num { font-size: 34px; font-weight: bold; }
        .stat-card .label { font-size: 11px; color: #6b7280; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
        .num-total     { color: #f59e0b; }
        .num-active    { color: #34d399; }
        .num-delivered { color: #60a5fa; }
        .num-cancelled { color: #f87171; }
        .num-users     { color: #c084fc; }

        /* Section Cards */
        .section-title {
            font-size: 16px; font-weight: bold; color: #f59e0b;
            margin-bottom: 14px; padding-bottom: 8px;
            border-bottom: 1px solid #0f3460;
        }
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .info-card {
            background: #16213e; border-radius: 8px; padding: 18px 20px;
            border: 1px solid #0f3460;
        }
        .info-card .label { font-size: 12px; color: #6b7280; margin-bottom: 6px; }
        .info-card .val { font-size: 22px; font-weight: bold; color: #e5e7eb; }

        .btn {
            display: inline-block; padding: 10px 22px; border-radius: 6px;
            font-size: 14px; font-weight: bold; text-decoration: none;
            cursor: pointer; border: none; transition: opacity 0.15s;
        }
        .btn:hover { opacity: 0.85; }
        .btn-yellow { background: #f59e0b; color: #1a1a1a; }
        .quick-links { display: flex; gap: 12px; margin-top: 20px; flex-wrap: wrap; }

        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .sidebar { display: none; }
        }
    </style>
</head>
<body>

    <header class="navbar">
        <a href="/admin/dashboard" class="logo">Food<span>Share</span> <small style="font-size:12px;color:#6b7280;">Admin</small></a>
        <div class="navbar-right">
            <span>🔑 <%= user.name %> (Admin)</span>
            <a href="/logout">Logout</a>
        </div>
    </header>

    <div class="layout">
        <!-- Sidebar -->
        <nav class="sidebar">
            <a href="/admin/dashboard" class="active">📊 Dashboard</a>
            <a href="/admin/donations">🍱 All Donations</a>
            <a href="/admin/users">👥 All Users</a>
        </nav>

        <div class="content">
            <div class="page-title">Admin Dashboard</div>
            <div class="page-sub">System-wide overview of all donations and users.</div>

            <!-- Main Stats Row -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="num num-total"><%= stats.totalDonations %></div>
                    <div class="label">Total Donations</div>
                </div>
                <div class="stat-card">
                    <div class="num num-active"><%= stats.activeDonations %></div>
                    <div class="label">Active</div>
                </div>
                <div class="stat-card">
                    <div class="num num-delivered"><%= stats.deliveredDonations %></div>
                    <div class="label">Delivered</div>
                </div>
                <div class="stat-card">
                    <div class="num num-cancelled"><%= stats.cancelledDonations %></div>
                    <div class="label">Cancelled</div>
                </div>
                <div class="stat-card">
                    <div class="num num-users"><%= stats.totalUsers %></div>
                    <div class="label">Total Users</div>
                </div>
            </div>

            <!-- Breakdown -->
            <div class="section-title">Donation Breakdown</div>
            <div class="info-grid">
                <div class="info-card">
                    <div class="label">Available (waiting for NGO)</div>
                    <div class="val"><%= stats.availableDonations %></div>
                </div>
                <div class="info-card">
                    <div class="label">Accepted by NGO</div>
                    <div class="val"><%= stats.acceptedDonations %></div>
                </div>
                <div class="info-card">
                    <div class="label">Picked Up (in transit)</div>
                    <div class="val"><%= stats.pickedUpDonations %></div>
                </div>
                <div class="info-card">
                    <div class="label">Registered Donors / NGOs</div>
                    <div class="val"><%= stats.totalDonors %> / <%= stats.totalNGOs %></div>
                </div>
            </div>

            <div class="quick-links">
                <a href="/admin/donations" class="btn btn-yellow">View All Donations</a>
                <a href="/admin/users" class="btn btn-yellow">Manage Users</a>
            </div>
        </div>
    </div>

</body>
</html>
